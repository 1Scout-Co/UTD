{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "UTD",
  "mainBinaryName": "UTD",
  "version": "0.1.0",
  "identifier": "app.utd.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "UTD",
        "width": 1320,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "publisher": "UTD contributors",
    "copyright": "Copyright © 2026 UTD contributors",
    "category": "Utility",
    "shortDescription": "Trình quản lý tải xuống mã nguồn mở",
    "longDescription": "UTD tải file lớn nhanh, resume trên mạng yếu, tải media và tích hợp trình duyệt. Không telemetry.",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "English",
          "Vietnamese"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEQUI0RjdEMzgxNzFBQkUKUldTK0doYzRmVStyZmVVRFZHaVdMalQ2bDh3YkNaWjdSemQ0YjNPMm1jYTNxYWpuMU5QZEx1WnUK",
      "endpoints": [
        "https://github.com/1Scout-Co/UTD/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
