{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "title": "UTD",
        "width": 1320,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 18 },
        "acceptFirstMouse": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "licenseFile": null,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": { "width": 600, "height": 380 },
        "appPosition": { "x": 160, "y": 180 },
        "applicationFolderPosition": { "x": 440, "y": 180 }
      }
    }
  }
}
