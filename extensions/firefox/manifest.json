{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",
  "permissions": ["contextMenus", "nativeMessaging", "storage", "activeTab", "scripting", "cookies", "downloads"],
  "host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": ["background.js", "takeover.js"]
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "utd@utd.app",
      "strict_min_version": "109.0"
    }
  }
}
