{
  "manifest_version": 3,
  "name": "UTD Download Manager",
  "version": "0.1.0",
  "description": "Gửi link sang UTD để tải nhanh, có kiểm tra an toàn.",
  "minimum_chrome_version": "102",
  "key": "",
  "permissions": ["contextMenus", "nativeMessaging", "storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tải bằng UTD",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  }
}
